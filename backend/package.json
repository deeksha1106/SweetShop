{
  "name": "sweet-shop-backend",
  "version": "1.0.0",
  "description": "Sweet Shop Backend API with Node.js, Express, and SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --watchAll --verbose --runInBand",
    "test:ci": "jest --ci --coverage --watchAll=false --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:unit": "jest tests/models tests/middleware tests/controllers --watchAll=false --runInBand",
    "test:integration": "jest tests/integration --watchAll=false --runInBand",
    "test:all": "npm run test:unit && npm run test:integration",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "keywords": ["sweet-shop", "api", "express", "sqlite", "jwt"],
  "author": "Sweet Shop Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "joi": "^17.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
